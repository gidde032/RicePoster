# Anthropic API (for caption generation)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Account display names
IG_ACCOUNT_A_NAME=Account A
IG_ACCOUNT_B_NAME=Account B
IG_ACCOUNT_C_NAME=Account C

# ─── Posting mode ───
# "mock"    = fake everything (for testing UI + captions)
# "browser" = Playwright automation (no API tokens needed, just login once)
# "api"     = official Meta/TikTok APIs (needs tokens below)
POST_MODE=mock

# true = browsers run hidden; false = browser windows visible.
#
# NOT just a debugging convenience — this is an Instagram detection setting.
# Measured 2026-07-27 with `python tools/probe_fingerprint.py`, headless Chrome
# reports two things visible Chrome does not:
#   * navigator.userAgent contains "HeadlessChrome/150...", while the Sec-CH-UA
#     client hints beside it still say "Google Chrome 150". A browser
#     contradicting itself about its own identity is a stronger signal than
#     either value alone, and no real browser does it.
#   * screen.colorDepth reports 24 instead of the 30 a real Mac display reports.
# Neither is fixable in code: Chrome derives both from the mode it started in,
# and forging the UA only moves the contradiction elsewhere.
# Set false if Instagram detection matters more than an unobtrusive desktop.
# Scheduled batches freeze this value when the batch is created, not when it
# fires, so a change does not reach batches already sitting in the queue.
HEADLESS=true

# How much the backend prints to the console. INFO (default) keeps the full
# browser-automation narration — every upload step, caption check and
# confirmation — which is what you want while watching a run. WARNING keeps
# only degraded and failed states, useful when running scheduled batches
# unattended. DEBUG, ERROR and CRITICAL also work.
#
# An unrecognised value is reported as a startup problem and falls back to
# INFO, rather than silently leaving you at the wrong verbosity.
LOG_LEVEL=INFO

# ─── Scheduler ───
# true (default) starts the scheduler loop with the server, so batches sitting
# in queue.jsonl fire at their scheduled time. false starts the server without
# it — the queue is still readable and editable in the UI, but nothing fires.
# Set false when you want the UI without any chance of an unattended post.
# SCHEDULER_ENABLED=true

# ─── Account slots ───
# Which slots exist, in order. Adding a slot needs a matching login and a
# matching entry in device_identity.DISPLAYS (the app refuses to start if
# there are more slots than distinct device fingerprints).
# ACCOUNT_SLOTS=A,B,C

# ─── Failure notifications (optional) ───
# "none" (default) = no notifications. "ntfy" = push via ntfy.sh.
# The topic is a bearer secret: anyone who knows it can push to your phone.
# Caption text is never sent — a sanitizer strips it at the boundary.
# NOTIFY_SERVICE=none
# NTFY_TOPIC=your-private-topic-string
# NTFY_SERVER=https://ntfy.sh

# ─── Anti-detection / pacing ───
# These three reduce the machine-like patterns Instagram flags accounts for:
# repeated automated page loads, browser traffic that isn't a post, and
# accounts posting back-to-back on an identical cadence.
# How long a successful session health check stays valid, in seconds.
# Default 21600 (6h). Caching removes most automated Instagram page loads.
# SESSION_CHECK_TTL_S=21600

# Which platforms get a *browser* pre-flight check before a scheduled batch.
# Default (and empty/unset) = instagram,tiktok. Drop a platform to keep the
# free no-session filtering while eliminating its browser traffic. Use the
# literal "none" to disable the browser pre-flight for both.
# PREFLIGHT_CHECK_PLATFORMS=tiktok

# Randomised gap between account slots in a run, in seconds. Default 60-180,
# so a 3-slot run takes 2-6 minutes longer; the UI shows a countdown. Posting
# accounts back-to-back is part of the pattern that links them. Set both to 0
# to disable.
# INTER_SLOT_DELAY_MIN_S=60
# INTER_SLOT_DELAY_MAX_S=180

# ─── Only needed if POST_MODE=api ───
# IG_ACCOUNT_A_ID=your_ig_user_id_a
# IG_ACCOUNT_A_TOKEN=your_long_lived_token_a
# IG_ACCOUNT_B_ID=your_ig_user_id_b
# IG_ACCOUNT_B_TOKEN=your_long_lived_token_b
# IG_ACCOUNT_C_ID=your_ig_user_id_c
# IG_ACCOUNT_C_TOKEN=your_long_lived_token_c
# TT_ACCOUNT_A_TOKEN=your_tiktok_token_a
# TT_ACCOUNT_B_TOKEN=your_tiktok_token_b
# TT_ACCOUNT_C_TOKEN=your_tiktok_token_c
